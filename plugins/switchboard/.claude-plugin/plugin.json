{
  "version": "0.9.0",
  "author": {
    "name": "akparhi"
  },
  "license": "Apache-2.0",
  "name": "switchboard",
  "description": "Shared Switchboard gateway, setup, status and reversible Claude startup integration.",
  "skills": "./skills",
  "hooks": "./hooks/hooks.json",
  "userConfig": {
    "fast": {
      "type": "boolean",
      "title": "Fast mode for Sol, Terra and Luna (uses more Codex allowance; never Astra)",
      "description": "",
      "default": false
    },
    "gpt_effort": {
      "type": "string",
      "title": "GPT effort for Sol, Astra, Terra and Luna subagents",
      "description": "session follows the session effort.",
      "options": [
        "session",
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "default": "session"
    },
    "sol": {
      "type": "boolean",
      "title": "Show Sol subagent",
      "description": "",
      "default": true
    },
    "astra": {
      "type": "boolean",
      "title": "Show Astra subagent",
      "description": "",
      "default": true
    },
    "terra": {
      "type": "boolean",
      "title": "Show Terra subagent",
      "description": "",
      "default": true
    },
    "luna": {
      "type": "boolean",
      "title": "Show Luna subagent",
      "description": "",
      "default": true
    },
    "deepseek": {
      "type": "boolean",
      "title": "Show DeepSeek subagent (needs a Zen key)",
      "description": "",
      "default": true
    },
    "claudeai_connectors_dirs": {
      "type": "string",
      "title": "Dirs where claude.ai connectors load (comma-separated, ~ allowed); off everywhere else",
      "description": "",
      "default": ""
    }
  }
}
