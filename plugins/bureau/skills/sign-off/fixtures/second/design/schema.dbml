Enum "parcel_place" {
  "locker"
  "desk"
  "collected"
  "returned"
}

Table "residents" {
  "id" uuid [pk]
  "flat" text [not null]
  "name" text [not null]
  "phone" text
  "notify_by" text [not null, default: 'push']
}

Table "lockers" {
  "id" uuid [pk]
  "bank" text [not null]
  "door_number" integer [not null]
  "size" text [not null]
}

Table "parcels" {
  "id" uuid [pk]
  "resident_id" uuid [not null]
  "locker_id" uuid [note: 'Cleared when the parcel leaves its door.']
  "place" parcel_place [not null, default: 'locker']
  "code_hash" text [not null]
  "dropped_at" timestamptz [not null, default: `now()`]
  "collect_by" timestamptz [not null]
  "extended_at" timestamptz
  "courier" text

  Indexes {
    locker_id [unique, name: "parcels_one_per_door"]
    collect_by [name: "parcels_due"]
  }
  Note: 'One row per parcel a courier leaves in the lobby.'
}

Ref:"residents"."id" <? "parcels"."resident_id"

Ref:"lockers"."id" <? "parcels"."locker_id"
