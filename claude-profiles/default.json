{
  "cleanupPeriodDays": 30,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-1[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5[1m]",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "250000",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "0",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "ENABLE_LSP_TOOL": "0",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "12000",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "true",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "true",
    "CLAUDE_CODE_DISABLE_WORKFLOWS": "true",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "true",
    "CLAUDE_CODE_ENABLE_DESIGN_SYNC": "false",
    "CLAUDE_CODE_ENABLE_MENU_KIND_LANES": "false",
    "CLAUDE_CODE_ARTIFACT_PREVIEW": "false",
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "false",
    "CLAUDE_CODE_ENABLE_EXPERIMENTAL_ADVISOR_TOOL": "false",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "false",
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "LS",
      "MultiEdit",
      "Read",
      "Skill",
      "TodoRead",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__plugin_bureau_codegraph__*"
    ],
    "deny": [
      "Read(./dist/**)",
      "Read(./next/**)",
      "PushNotification",
      "NotebookEdit",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "CronCreate",
      "CronList",
      "CronDelete",
      "ScheduleWakeup",
      "DesignSync",
      "RemoteTrigger",
      "ShareOnboardingGuide",
      "ReportFindings",
      "PublishPlugin",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "Agent(statusline-setup)",
      "Agent(claude-code-guide)",
      "mcp__t3-code__create_threads",
      "mcp__t3-code__delegate_task",
      "mcp__t3-code__device_close",
      "mcp__t3-code__device_list",
      "mcp__t3-code__device_open",
      "mcp__t3-code__device_screenshot",
      "mcp__t3-code__orchestrator_capabilities",
      "mcp__t3-code__t3_attachment_discard",
      "mcp__t3-code__t3_attachment_prepare_upload",
      "mcp__t3-code__t3_environment_preferences_update",
      "mcp__t3-code__t3_environment_read",
      "mcp__t3-code__t3_pending_request_list",
      "mcp__t3-code__t3_pending_request_read",
      "mcp__t3-code__t3_pending_request_respond",
      "mcp__t3-code__t3_project_clone",
      "mcp__t3-code__t3_project_create",
      "mcp__t3-code__t3_project_delete",
      "mcp__t3-code__t3_project_list",
      "mcp__t3-code__t3_project_read",
      "mcp__t3-code__t3_project_update",
      "mcp__t3-code__t3_queue_cancel",
      "mcp__t3-code__t3_queue_edit",
      "mcp__t3-code__t3_queue_list",
      "mcp__t3-code__t3_queue_promote_to_steer",
      "mcp__t3-code__t3_queue_read",
      "mcp__t3-code__t3_queue_reorder",
      "mcp__t3-code__t3_thread_configuration",
      "mcp__t3-code__t3_thread_configure",
      "mcp__t3-code__t3_thread_fork",
      "mcp__t3-code__t3_thread_interrupt",
      "mcp__t3-code__t3_thread_launch",
      "mcp__t3-code__t3_thread_list",
      "mcp__t3-code__t3_thread_merge_back",
      "mcp__t3-code__t3_thread_organize",
      "mcp__t3-code__t3_thread_read",
      "mcp__t3-code__t3_thread_search",
      "mcp__t3-code__t3_thread_send",
      "mcp__t3-code__t3_thread_send_attachments",
      "mcp__t3-code__t3_thread_transfers",
      "mcp__t3-code__t3_thread_update",
      "mcp__t3-code__t3_thread_wait",
      "mcp__t3-code__t3_workflow_stop",
      "mcp__t3-code__t3_worktree_handoff",
      "mcp__t3-code__t3_worktree_list",
      "mcp__t3-code__t3_worktree_status",
      "mcp__t3-code__task_cancel",
      "mcp__t3-code__task_status",
      "mcp__t3-code__request_secret"
    ],
    "defaultMode": "bypassPermissions"
  },
  "skillOverrides": {
    "security-review": "off",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off",
    "plugin-authoring": "off",
    "update-config": "off",
    "dataviz": "off"
  },
  "disableBundledSkills": true,
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Funk.aiff"
          }
        ]
      }
    ],
    "PostToolUse": [],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Funk.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '.agent_id // empty' >/dev/null 2>&1 || afplay /System/Library/Sounds/Submarine.aiff"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "bashEditDiffEnabled": true,
  "bashOutputMaxChars": 16000,
  "enabledPlugins": {
    "agents-md@builtin": false,
    "plugin-authoring@builtin": false,
    "sec-default@builtin": false,
    "telemetry@builtin": false,
    "context7@claude-plugins-official": false,
    "switchboard@akparhi": true,
    "skill-creator@claude-plugins-official": true,
    "bureau@akparhi": true
  },
  "extraKnownMarketplaces": {
    "akparhi": {
      "source": {
        "source": "directory",
        "path": "/Users/akparhi/Projects/Home/context-engineering"
      }
    }
  },
  "outputStyle": "bureau:terse",
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
