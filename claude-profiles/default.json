{
  "cleanupPeriodDays": 14,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-1[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "256000",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "0",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "12000"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "LS",
      "MultiEdit",
      "Read",
      "Skill",
      "TodoRead",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "deny": [
      "Read(./dist/**)",
      "Read(./next/**)",
      "PushNotification",
      "NotebookEdit",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "CronCreate",
      "CronList",
      "CronDelete",
      "ScheduleWakeup",
      "DesignSync",
      "RemoteTrigger",
      "ShareOnboardingGuide",
      "ReportFindings",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "LSP"
    ],
    "defaultMode": "bypassPermissions"
  },
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "superpowers:using-git-worktrees": "off",
    "claude-api": "off",
    "loop": "off",
    "schedule": "off",
    "security-review": "off",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off",
    "plugin-authoring": "off",
    "update-config": "off",
    "superpowers:diagnosing-superpowers": "off"
  },
  "hooks": {
    "Notification": [],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff"
          }
        ]
      }
    ],
    "PostToolUse": [],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/output-styles/reminder.md\" 2>/dev/null"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '.agent_id // empty' >/dev/null 2>&1 || afplay /System/Library/Sounds/Sosumi.aiff"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/output-styles/reminder.md\" 2>/dev/null"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "bashEditDiffEnabled": true,
  "bashOutputMaxChars": 16000,
  "enabledPlugins": {
    "agents-md@builtin": false,
    "plugin-authoring@builtin": false,
    "sec-default@builtin": false,
    "telemetry@builtin": false,
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "switchboard@akparhi": true
  },
  "extraKnownMarketplaces": {
    "akparhi": {
      "source": {
        "source": "directory",
        "path": "/Users/akparhi/Projects/Home/context-engineering"
      }
    }
  },
  "outputStyle": "terse",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "plansDirectory": "./.claude/plans",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "verbose": true,
  "switchModelsOnFlag": false,
  "fileCheckpointingEnabled": true,
  "terminalProgressBarEnabled": false,
  "tipsEnabled": false
}
