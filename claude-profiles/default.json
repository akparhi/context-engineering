  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "pluginConfigs": {
    "switchboard@akparhi": {
      "options": {
        "astra": true,
        "astra_low": false,
        "astra_medium": false,
        "astra_high": false,
        "astra_xhigh": false,
        "sol": true,
        "sol_low": false,
        "sol_medium": false,
        "sol_high": false,
        "sol_xhigh": false,
        "luna": false,
        "luna_low": false,
        "luna_medium": false,
        "luna_high": false,
        "luna_xhigh": false,
        "deepseek": true,
        "fast": true
      }
    },
    "bureau@akparhi": {
      "options": {
        "role_reviewer": "sol"
      }
    }
  },
  "plansDirectory": "./.claude/plans",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "verbose": true,
  "switchModelsOnFlag": false,
  "fileCheckpointingEnabled": true,
  "terminalProgressBarEnabled": false,
  "crossSessionInbound": "refuse",
  "tipsEnabled": false
}