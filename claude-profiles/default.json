{
  "alwaysThinkingEnabled" : false,
  "attribution" : {
    "sessionUrl" : false
  },
  "autoUpdatesChannel" : "latest",
  "cleanupPeriodDays" : 30,
  "disableArtifact" : true,
  "disableClaudeAiConnectors" : true,
  "disableRemoteControl" : true,
  "disableWorkflows" : true,
  "effortLevel" : "low",
  "enabledPlugins" : {
    "codex@openai-codex" : true,
    "commit-commands@claude-plugins-official" : true,
    "context-mode@context-mode" : true,
    "context7@claude-plugins-official" : true,
    "superpowers@claude-plugins-official" : true,
    "typescript-lsp@claude-plugins-official" : true
  },
  "env" : {
    "ANTHROPIC_DEFAULT_FABLE_MODEL" : "claude-fable-5-1[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL" : "claude-opus-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL" : "claude-sonnet-4-6",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW" : "256000",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT" : "0",
    "CLAUDE_CODE_EFFORT_LEVEL" : "low",
    "CLAUDE_CODE_ENABLE_TELEMETRY" : "0",
    "ENABLE_LSP_TOOL" : "1"
  },
  "extraKnownMarketplaces" : {
    "context-mode" : {
      "source" : {
        "repo" : "mksglu\/context-mode",
        "source" : "github"
      }
    },
    "openai-codex" : {
      "source" : {
        "repo" : "openai\/codex-plugin-cc",
        "source" : "github"
      }
    }
  },
  "fileCheckpointingEnabled" : true,
  "hooks" : {
    "Notification" : [],
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "afplay \/System\/Library\/Sounds\/Ping.aiff",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "PostToolUse" : [

    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "afplay \/System\/Library\/Sounds\/Ping.aiff",
            "type" : "command"
          }
        ],
        "matcher" : "AskUserQuestion"
      },
      {
        "hooks" : [
          {
            "command" : "afplay \/System\/Library\/Sounds\/Ping.aiff",
            "type" : "command"
          }
        ],
        "matcher" : "ExitPlanMode"
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "\"${CLAUDE_CONFIG_DIR:-$HOME\/.claude}\/hooks\/context-mode-cache-heal.mjs\"",
            "type" : "command"
          },
          {
            "command" : "cat \"${CLAUDE_CONFIG_DIR:-$HOME\/.claude}\/output-styles\/reminder.md\" 2>\/dev\/null",
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "jq -e '.agent_id \/\/ empty' >\/dev\/null 2>&1 || afplay \/System\/Library\/Sounds\/Sosumi.aiff",
            "type" : "command"
          }
        ],
        "matcher" : ""
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "cat \"${CLAUDE_CONFIG_DIR:-$HOME\/.claude}\/output-styles\/reminder.md\" 2>\/dev\/null",
            "type" : "command"
          }
        ]
      }
    ]
  },
  "outputStyle" : "terse",
  "permissions" : {
    "allow" : [
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "LS",
      "MultiEdit",
      "Read",
      "Skill",
      "TodoRead",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "defaultMode" : "bypassPermissions",
    "deny" : [
      "Read(.\/dist\/**)",
      "Read(.\/next\/**)",
      "PushNotification",
      "NotebookEdit",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "CronCreate",
      "CronList",
      "CronDelete",
      "ScheduleWakeup"
    ]
  },
  "plansDirectory" : ".\/.claude\/plans",
  "promptSuggestionEnabled" : false,
  "skipDangerousModePermissionPrompt" : true,
  "spinnerTipsEnabled" : false,
  "switchModelsOnFlag" : false,
  "terminalProgressBarEnabled" : false,
  "theme" : "auto",
  "tipsEnabled" : false,
  "tui" : "fullscreen",
  "verbose" : true
}