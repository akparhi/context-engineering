#!/usr/bin/env bash
#
# Link a Claude Code config directory at this repo's shared config and one
# profile's settings.json.
#
#   bin/link-profile                       # default profile -> ~/.claude
#   bin/link-profile darkforest            # darkforest profile -> ~/.claude
#   bin/link-profile default ~/.work       # explicit profile and destination
#
# Re-running is safe: an existing symlink is repointed, and a real file or
# directory is moved aside to <name>.bak.<timestamp> rather than overwritten.

set -euo pipefail

profile="${1:-default}"
dest="${2:-$HOME/.claude}"
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

settings="$repo/claude-profiles/$profile.json"
if [[ ! -f "$settings" ]]; then
  echo "error: no such profile '$profile'" >&2
  echo "available:" >&2
  for f in "$repo"/claude-profiles/*.json; do
    echo "  $(basename "$f" .json)" >&2
  done
  exit 1
fi

# Expand ~ so the destination can be passed quoted.
dest="${dest/#\~/$HOME}"
mkdir -p "$dest"

link() {
  local target="$1" path="$2"

  if [[ -L "$path" ]]; then
    local current
    current="$(readlink "$path")"
    if [[ "$current" == "$target" ]]; then
      echo "  ok       $(basename "$path")"
      return
    fi
    rm "$path"
    echo "  relinked $(basename "$path")  (was $current)"
  elif [[ -e "$path" ]]; then
    # Never destroy real config: a hand-written settings.json here is the only
    # copy, and this script is expected to run on machines that already have one.
    local backup="$path.bak.$(date +%s)"
    mv "$path" "$backup"
    echo "  backed up $(basename "$path") -> $(basename "$backup")"
  else
    echo "  linked   $(basename "$path")"
  fi

  ln -s "$target" "$path"
}

echo "profile '$profile' -> $dest"
link "$settings" "$dest/settings.json"
link "$repo/claude-shared/skills" "$dest/skills"
link "$repo/claude-shared/output-styles" "$dest/output-styles"
link "$repo/claude-shared/CLAUDE.md" "$dest/CLAUDE.md"
